rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function superAdmin() { return signedIn() && role() == 'super_admin'; }
    function leader() { return signedIn() && role() in ['super_admin', 'pastor', 'secretary']; }
    function contentEditor() { return signedIn() && role() in ['super_admin', 'pastor', 'secretary', 'event_manager']; }
    function ministryEditor() { return signedIn() && role() in ['super_admin', 'pastor', 'choir_president', 'youth_leader']; }
    function mediaEditor() { return signedIn() && role() in ['super_admin', 'pastor', 'media']; }

    // Members may see only their own assigned profile. Role creation and updates
    // must be performed by a trusted admin process (Admin SDK / Cloud Function).
    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if leader();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == 'member'
        && request.resource.data.email == request.auth.token.email;
      allow update, delete: if superAdmin();
    }

    match /announcements/{itemId} { allow read: if true; allow create, update, delete: if contentEditor(); }
    match /events/{itemId} { allow read: if true; allow create, update, delete: if contentEditor(); }
    match /sermons/{itemId} { allow read: if true; allow create, update, delete: if mediaEditor(); }
    match /ministries/{itemId} { allow read: if signedIn(); allow create, update, delete: if ministryEditor(); }
    match /giving/{itemId} { allow read, create, update, delete: if signedIn() && role() in ['super_admin', 'finance']; }
    match /prayerRequests/{itemId} { allow read: if leader(); allow create: if signedIn(); allow update, delete: if leader(); }

    // Public content will receive collection-specific rules as it is introduced.
  }
}
